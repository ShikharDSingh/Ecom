{
  "name": "stockflow-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean",
    "proto:generate": "buf generate --template packages/contracts/buf.gen.yaml packages/contracts/proto",
    "db:migrate": "node scripts/db/run-migrations.mjs",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down -v"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.54.0",
    "@bufbuild/protobuf": "^2.6.2",
    "@bufbuild/protoc-gen-es": "^2.6.2",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "node-pg-migrate": "^7.1.0",
    "tsup": "^8.1.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^3.24.1"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.57.1",
    "@opentelemetry/sdk-node": "0.57.1",
    "amqplib": "^0.10.0",
    "dotenv": "^16.4.7",
    "env-var": "^7.1.1",
    "ioredis": "^5.6.0",
    "pg": "^8.13.0",
    "pino": "^9.1.0",
    "uuid": "^11.0.0"
  }
}
